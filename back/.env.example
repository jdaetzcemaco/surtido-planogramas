# ─── SERVIDOR ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development            # development | production

# ─── BASE DE DATOS (SQL Server) ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=1433
DB_NAME=planogramas
DB_USER=sa
DB_PASSWORD=tu_password_aqui
DB_SCHEMA=dbo
DB_ENCRYPT=false                # true en Azure SQL / producción
DB_TRUST_SERVER_CERTIFICATE=true  # true en desarrollo local; false en producción

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173   # URL del frontend (Vite dev server)

# ─── AUTENTICACIÓN (Entra ID / Azure AD) ─────────────────────────────────────
# Pendiente de configurar — ver REUNION_TECNICA.md
JWT_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
JWT_AUDIENCE=api://planogramas-cemaco

# ─── CAO — CemacoAllInOne (primer salto de autenticación) ────────────────────
# CAO_BASE_URL ya incluye el sufijo /api (ej. https://cemacoallinone.azurewebsites.net/api).
# POST {CAO_BASE_URL}/auth { user, password } → { data: { token } } (token CAO)
CAO_BASE_URL=host
CAO_USER=tu_usuario_cao
CAO_PASSWORD=tu_password_cao

# ─── CATI (catálogo y jerarquía — segundo salto) ──────────────────────────────
# CATI_BASE_URL ya incluye el sufijo /api (ej. http://10.20.12.9:8881/api). Solo accesible
# desde la red interna/VPN de Cemaco — no responde desde una red externa.
# POST {CATI_BASE_URL}/Auth/exchange { tokenCemacoAllInOne: tokenCAO } → { accessToken }
# Todas las llamadas a CATI envían AMBAS credenciales:
#   - Header Authorization: Bearer {accessToken}  (JWT — endpoints que lo requieren)
#   - Header x-api-key: {CATI_API_KEY}            (API key — endpoints que lo requieren)
CATI_BASE_URL=host
CATI_API_KEY=tu_api_key_cati

# ─── OpenAI (agentes — ver back/src/agents/) ──────────────────────────────────
OPENIA_TOKEN=tu_api_key_openai
OPENAI_MODEL=gpt-4o-mini

# ─── AZURE BLOB STORAGE (adjuntos de PlanogramaVersion) ───────────────────────
# Contenedor privado — la descarga real siempre pasa por el backend (GET /adjuntos/:id/descargar).
# Portal: Storage Account → Seguridad + redes → Claves de acceso → Cadena de conexión.
AZURE_STORAGE_CONNECTION_STRING=tu_connection_string_aqui
AZURE_STORAGE_CONTAINER_ADJUNTOS=adjuntos
